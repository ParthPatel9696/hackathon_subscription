# Server Port
PORT=5000
## Run `npm run billing:worker` as a separate process to create due invoices automatically.
BILLING_WORKER_INTERVAL_MINUTES=15

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/brightloop_subscriptions

# JWT Secret Key for Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Optional SMTP for password reset links and invoice delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
